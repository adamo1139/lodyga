# Template for .env — copy, then fill in real values:
#
#     cp .env.example .env
#     chmod 600 .env
#
# .env is gitignored and must never be committed. This template is committed,
# so keep it free of real key material.
#
# The runners read .env from the working directory, so run them from this
# directory. Real environment variables take precedence over anything here, so
# `OPENROUTER_API_KEY=... python judge_lodyga.py ...` still overrides the file.

# Judge API key, used by judge_lodyga.py. The variable name is whatever
# `api.api_key_env` in the judge config points at; config.judge.example.toml
# uses OPENROUTER_API_KEY.
OPENROUTER_API_KEY=

# Only needed if the generation endpoint requires auth. A local SGLang/vLLM
# server normally does not, so leave this out unless `api.api_key_env` is set in
# the model config.
#GENERATION_API_KEY=
