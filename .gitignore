
# Beads: keep the whole tracker private (see lodyga-dhf)
/.beads/
# Credential key material (never commit)
.beads-credential-key
# Dolt artifacts
.dolt/
*.db

# API keys (see custom_scoring.md; never commit)
.env

# Generated results. Every run is archived in its own timestamped directory
# with the configs that produced it, so results are reproducible rather than
# version-controlled; the raw judge archives are large and would bloat history.
# Publish a specific run deliberately with `git add -f` if it needs to ship.
/data/mt_bench/runs/
# Superseded by runs/ — the flat layout used before run directories existed.
/data/mt_bench/model_answer/
/data/mt_bench/model_judgment/

# Local working judge config (copy config.judge.example.toml). Kept out of git
# so a local judge/model choice cannot silently become the committed default.
/configs/config.judge.toml

# Wykresy generowane przez wykresy.py z leaderboard.md i tokeny.toml. Odtwarza
# je jedno polecenie, a PNG-i w historii puchłyby przy każdym nowym wyniku.
/wykresy/

# Python
__pycache__/

# Jednorazowa tabela porównawcza, nie element harnessu (zostaje lokalnie).
/tabela.py
